{
	"version": "2.0.0",
	"tasks": [
		// Code generation (continuous)
		{
			"label": "build_runner watch",
			"detail": "Code generation (continuous)",
			"type": "shell",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"watch",
				"--delete-conflicting-outputs"
			],
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"panel": "dedicated",
			},
			"runOptions": {
				"runOn": "folderOpen"
			},
		},
	]
}
